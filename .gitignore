# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
src/*.egg-info/
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# Env / secrets
.env
.env.*
!.env.example

# IDEs / editors
.vscode/
.idea/
*.swp

# OS junk
.DS_Store
Thumbs.db

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Logs
*.log

# ─────────────────────────────────────────────────────────────────────────────
# USER-GENERATED / RUNTIME DATA — never tracked.
# Created when users run conversions/generations. Anchored at the runtime root
# (repo root in dev, PHANSORA_DATA_DIR in prod). The directory structure is kept
# via .gitkeep files; the contents are ignored.
# ─────────────────────────────────────────────────────────────────────────────

# SpokenVerse — generated audio/text, history, upload staging, custom voices
output_audio/
output_txt/
history/
input_pdf/
input_txt/
.tmp_uploads/
# The per-user voice store appears at the repo root (dev — runtime_root defaults to CWD)
# and under data/ (prod — PHANSORA_DATA_DIR). Both are listed explicitly rather than as a
# bare `voices/`, which would also swallow assets/voices/ — the app-wide default voices,
# which ARE tracked (shipped content, see voices.py).
/voices/
data/voices/

# Book Alchemy — per-user source uploads + narrated session audio
/book_alchemy/

# Research Atlas — temp uploads + generated TOC output
tmp/
toc/

# Dossier Nova's retired local vector store. Nothing writes it any more; ignored so a
# copy left on an older host does not show up as untracked.
data/dossier_nova/

# Chrono-Origin — cached trace results (written on every trace)
data/chrono_origin/cache/*
!data/chrono_origin/cache/.gitkeep

# Any stray SQLite stores
*.db
*.sqlite
*.sqlite3

# systemd unit files are environment-specific
*.service
# …except the production unit kept under deploy/, the one to copy onto a new server.
!deploy/phansora-api.service

# prompt_lab scratch file — an experiment in progress, not source
chrono-prompt.txt
