# ==============================================================================
# phansora-api (FastAPI) — environment
# ==============================================================================
# Every variable below is read somewhere in src/. Nothing here is decorative: if
# you delete a line, some code path loses its setting.
#
#   REQUIRED   the app (or that product) fails without it
#   otherwise  has a default in code, shown as the value or in the comment above
#
# One process serves every product under a path prefix:
#   /spokenverse  /book-alchemy  /dossier  /chrono  /studio
#
# CONVENTION — comments go on their OWN line, never after a value.
# python-dotenv strips a trailing comment from a NON-empty value but keeps it as
# the value of an EMPTY one, so `KEY=   # note` sets KEY to the literal "# note".
# That silently poisons blank secrets and blank overrides. Keep it on its own line.
#
# DEV vs PROD differences are noted inline where they matter.
# ==============================================================================


# ==============================================================================
# Core service
# ==============================================================================
PHANSORA_APP_NAME=Phansora API
PHANSORA_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000

# Comma-separated allowed origins. dev: *   prod: real domains.
CORS_ALLOW_ORIGINS=*

# Root for generated audio and uploads. Blank = process working directory.
# dev: blank or ./data   prod: /var/lib/phansora
PHANSORA_DATA_DIR=

# Root for shipped, read-only content that travels with the repo — currently the
# app-wide default voices (assets/voices/) and the built-in voice's reference clip.
# Blank = <repo>/assets, derived from the installed package location — correct for the
# normal editable/checkout deploy. Only set this if the package is installed as a copied
# wheel, where the code no longer sits next to the repo's assets/ directory.
PHANSORA_ASSETS_DIR=


# ==============================================================================
# Database — the same Postgres the Node app migrates
# ==============================================================================
# REQUIRED (no defaults)
DB_NAME=
DB_USER=
# secret
DB_PASSWORD=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_POOL_MAX=5


# ==============================================================================
# API authentication (REQUIRED)
# ==============================================================================
# Shared with the Node app's PHANSORA_INTERNAL_KEY — the two must match exactly.
# Long random string, e.g. `openssl rand -hex 32`. Secret.
#
# Node sends it as X-Phansora-Internal-Key on server-to-server calls, and signs
# the short-lived bearer tokens the browser uses for the products it calls
# directly. Blank means every non-public route answers 503: this API used to
# trust a client-supplied user_id with no authentication at all, so it now fails
# CLOSED rather than open. Set PHANSORA_AUTH_DISABLED=1 for local dev only.
PHANSORA_INTERNAL_KEY=
PHANSORA_AUTH_DISABLED=

# ==============================================================================
# Admin endpoints (/admin)
# ==============================================================================
# Long random string; the Node frontend sends it as X-Admin-Key. Blank locks the
# protected admin routes (403). Secret.
PHANSORA_ADMIN_KEY=

# Paths the storage report reads. PHANSORA_API_DIR blank = installed repo root.
PHANSORA_API_DIR=
PHANSORA_FRONTEND_DIR=/var/www/phansora

# Model caches the admin panel reports disk usage for. Blank = library defaults.
HF_HOME=
TORCH_HOME=


# ==============================================================================
# AI providers
# ==============================================================================
# Model NAMES are required — there is no built-in default anywhere in the code.
# A hardcoded name is only correct until the provider retires it (which is what
# happened to `deepseek-chat`), and then it fails from inside the code where an
# .env edit cannot reach it. An unset model raises MissingModelConfig at startup,
# naming the variable to set.

# ── DeepSeek ──────────────────────────────────────────────────────────────────
# REQUIRED for deepseek-backed products — secret
DEEPSEEK_API_KEY=

DEEPSEEK_BASE_URL=https://api.deepseek.com
# REQUIRED
DEEPSEEK_MODEL=deepseek-v4-flash

# Judgement/reasoning calls. BLANK = follow DEEPSEEK_MODEL, which is right for
# DeepSeek v4 (flash and pro both reason; there is no separate reasoner SKU).
# Set it only to spend more on judgement, e.g. deepseek-v4-pro.
DEEPSEEK_REASONING_MODEL=

DEEPSEEK_TIMEOUT_SECONDS=90
DEEPSEEK_MAX_RETRIES=1

# The budget for one judgement call — and reasoning tokens are billed against it, so the
# model's thinking and its answer share this number.
#
# 8000 was not enough for an evidence-heavy Chrono Origin synthesize: the budget went on
# reasoning, the JSON was cut off mid-document, and the trace came back with an empty
# origin and timeline. The client now detects that and retries with double the budget
# (up to the ceiling below), so 8000 is survivable — but the first attempt is paid for
# and thrown away, which is why this starts higher.
DEEPSEEK_REASON_MAX_TOKENS=16000
# How far the truncation retry may escalate. Past this, a prompt is not large, it is
# wrong — and doubling forever turns one bad trace into an expensive one.
DEEPSEEK_REASON_MAX_TOKENS_CEILING=32000
DEEPSEEK_SEARCH_MAX_TOKENS=1024

# ── OpenAI ────────────────────────────────────────────────────────────────────
# REQUIRED for openai-backed products — secret
OPENAI_API_KEY=

# REQUIRED
OPENAI_MODEL=gpt-5-nano
# Blank = api.openai.com
OPENAI_BASE_URL=

# Both blank = use OPENAI_MODEL.
OPENAI_SEARCH_MODEL=
OPENAI_REASONING_MODEL=

# Reasoning effort: minimal | low | medium | high
OPENAI_REASON_EFFORT=medium
OPENAI_LIGHT_EFFORT=low
OPENAI_SEARCH_EFFORT=low

# Reasoning tokens are spent BEFORE output and count against this cap. Too low
# (e.g. 8000) returns empty JSON on big prompts. It is a cap, not a fixed cost.
OPENAI_REASON_MAX_TOKENS=24000
OPENAI_SEARCH_MAX_TOKENS=4000

# Set to web_search_preview on older API tiers.
OPENAI_WEB_SEARCH_TOOL=web_search

# ── Gemini ────────────────────────────────────────────────────────────────────
# REQUIRED for CHRONO_LLM_PROVIDER=gemini — secret. GOOGLE_API_KEY also works.
GEMINI_API_KEY=

# REQUIRED. No built-in default on purpose: a hardcoded model name breaks
# silently when the provider retires it.
GEMINI_MODEL=gemini-3.5-flash-lite
# Blank = use GEMINI_MODEL.
GEMINI_REASONING_MODEL=

# The model that runs the grounded research call. Blank = use GEMINI_MODEL.
#
# Worth setting, because searching is not the same job as the rest. Whether a
# search happens at all is the MODEL's decision — google_search is elected, not
# commanded — and the lite tiers decline it, answer from memory and return no
# groundingMetadata, which Chrono-Origin has to treat as a failed trace. Measured
# on gemini-3.5-flash-lite: it declined a research prompt, declined the retry that
# put "you must search" in the system channel, and returned a fluent list it had
# not looked anything up for.
#
# Set this to a tier that reliably reaches for the tool and leave GEMINI_MODEL on
# a lite tier for synthesis, which is formatting work. Staying inside the 3.x
# family keeps the free grounding allowance the block above depends on.
#
# If a 3.x tier still will not search, gemini-2.5-flash has the strongest evidence
# of grounding and reporting it — but it sits OUTSIDE that free allowance, so it
# moves grounding onto the bill. Check the trade before reaching for it.
GEMINI_SEARCH_MODEL=gemini-3.5-flash

# Grounding is billed per grounded REQUEST, not per token, with a free monthly
# allowance on the 3.x family. That is why 3.5-flash-lite is the default here
# despite a higher token price than 2.5: at Chrono-Origin's volume the free
# grounding allowance dominates the bill.
GEMINI_TIMEOUT_S=90
# Caps, not costs. Set where the work fits: a budget too small means generating
# an answer, throwing it away and generating it again.
GEMINI_REASON_MAX_TOKENS=32000
GEMINI_SEARCH_MAX_TOKENS=4000


# ==============================================================================
# Per-product model overrides
# ==============================================================================
# Resolution, most specific first:
#   <PRODUCT>_MODEL  ->  DEEPSEEK_MODEL / OPENAI_MODEL  ->  raise
# Blank follows the provider-wide var. Set one to give a single product a
# different model without touching the rest (cheap+fast for bulk OCR cleanup,
# stronger for research/synthesis). Which provider a product uses is set by its
# *_LLM_PROVIDER var where it has one.
#
#   BOOK_ALCHEMY_MODEL     Book Alchemy     (deepseek)
#   DOSSIER_MODEL          Dossier Nova     (deepseek)
#   SPOKENVERSE_OCR_MODEL  SpokenVerse OCR  (deepseek)
#   CHRONO_MODEL           Chrono-Origin    (CHRONO_LLM_PROVIDER)
#   NARRAVA_MODEL          Narrava Studio   (NARRAVA_LLM_PROVIDER)
BOOK_ALCHEMY_MODEL=
DOSSIER_MODEL=
SPOKENVERSE_OCR_MODEL=
CHRONO_MODEL=
NARRAVA_MODEL=

# Same idea for judgement calls:
#   <PRODUCT>_REASONING_MODEL -> {DEEPSEEK,OPENAI}_REASONING_MODEL -> chat chain
# Blank means the product reasons with its chat model.
BOOK_ALCHEMY_REASONING_MODEL=
DOSSIER_REASONING_MODEL=
SPOKENVERSE_REASONING_MODEL=
CHRONO_REASONING_MODEL=
NARRAVA_REASONING_MODEL=

# ── Legacy DeepSeek names ─────────────────────────────────────────────────────
# Only needed if a deployment predates the canonical DEEPSEEK_* names above.
DEEPSEEK_CHAT_API_KEY=
DEEPSEEK_CHAT_BASE_URL=
DEEPSEEK_CHAT_MODEL=


# ==============================================================================
# SpokenVerse — TTS + transcription
# ==============================================================================
# Blank = built-in default engine. Retired aliases degrade to CosyVoice2.
TTS_ENGINE=
# 1 loads the TTS model at startup; 0 defers to the first request.
TTS_PRELOAD=1

COSYVOICE2_REPO=/var/www/CosyVoice
# Blank = <COSYVOICE2_REPO>/pretrained_models/CosyVoice2-0.5B
COSYVOICE2_MODEL_DIR=
COSYVOICE2_LANGUAGE=
COSYVOICE2_REF_AUDIO=
COSYVOICE2_DEFAULT_REF=
COSYVOICE2_DEFAULT_REF_TEXT=

# GPU acceleration. All three are CUDA-only and are ignored on CPU; default 1.
# On a CPU box set them to 0 — generation is slow but works.
COSYVOICE2_FP16=1
COSYVOICE2_USE_VLLM=1
COSYVOICE2_USE_TRT=1

# Narration speed multiplier, 0.5–2.0.
COSYVOICE2_SPEED=1.0
# Per-chunk character cap. The engine drops words on long chunks, especially with
# cloned voices — 200 is the measured safe ceiling. Raise with care.
COSYVOICE2_MAX_CHARS=200

# Read by PyTorch itself, not by this codebase — do not remove it as "unused".
# expandable_segments cuts CUDA fragmentation across long generation runs.
# GPU deployments only; harmless on CPU.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# faster-whisper — audio-to-text, and Book Alchemy reference transcripts.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WHISPER_VAD_FILTER=true
# Blank = library default.
WHISPER_CPU_THREADS=
WHISPER_NUM_WORKERS=


# ==============================================================================
# Book Alchemy
# ==============================================================================
# The worker POSTs scripts to this same process's TTS endpoint.
# dev: http://127.0.0.1:8000   prod: the internal API base
PHANSORA_API_BASE=http://127.0.0.1:8000

BOOK_ALCHEMY_DB_POOL=5
# Seconds between worker poll ticks.
BOOK_ALCHEMY_IDLE_SLEEP=5
# Worker lease; an expired lease is reclaimed (crash recovery).
BOOK_ALCHEMY_LEASE_SECONDS=600
# Full synthesis runs server-side before the response, so this must cover it.
BOOK_ALCHEMY_TTS_HTTP_TIMEOUT_S=3600
# Courses a user may hold at once. Each finished course is hundreds of MB of
# narration, so this caps disk, not compute: at 1 they must download and delete
# their current course before starting another.
BOOK_ALCHEMY_MAX_PROJECTS=1


# ==============================================================================
# Chrono-Origin
# ==============================================================================
# gemini -> native Google Search grounding (default; the model searches for
#           itself, and the search block below is not used at all).
# openai -> native web_search tool.
# deepseek -> DeepSeek has no hosted search tool, so it needs the external
#           search block below, which now REQUIRES a Brave key or a SearXNG URL.
CHRONO_LLM_PROVIDER=gemini

# MAX_DEPTH is a ceiling, not a target: the research loop stops as soon as a
# round adds no new dated mentions, so most traces finish in 2-3 rounds. Raise
# MIN_DEPTH to force more searching, MAX_DEPTH to allow it on stubborn subjects.
CHRONO_MAX_DEPTH=4
CHRONO_MIN_DEPTH=2
CHRONO_MAX_SOURCES_PER_STAGE=8
CHRONO_MAX_QUERIES_PER_STAGE=5
# Applies to the synchronous /trace and /expand endpoints only; async trace jobs
# are not bounded by it. Reading source pages made traces slower but cheaper.
CHRONO_REQUEST_TIMEOUT_S=240
CHRONO_CACHE_DIR=./data/chrono_origin/cache

# Reading real source pages. Search returns titles and URLs — it cannot tell you
# whether a manuscript is the original or a later copy, so the top-tier sources
# are opened and read before anything is judged. This is the expensive half of
# the token budget; keep it small. 0 disables reading entirely, and every
# provenance field then rests on search summaries alone (the UI says so).
CHRONO_READ_SOURCES=4
CHRONO_READ_CHARS=6000
CHRONO_EXPAND_READ_SOURCES=2

# Ceiling on evaluated connections between timeline items.
CHRONO_MAX_CONNECTIONS=24

# Web search backend — ONLY used when CHRONO_LLM_PROVIDER=deepseek. The gemini
# and openai providers search natively and ignore everything below.
#   auto | brave | searxng
# There is no keyless option any more. DuckDuckGo was removed: it answered 202
# when throttled, which arrives as an empty result list, so a throttled trace
# reported "no evidence found" for subjects with abundant surviving evidence.
# With nothing configured, searches are skipped and SAY SO in the log rather
# than returning quiet emptiness.
CHRONO_SEARCH_PROVIDER=auto
# Required for provider=brave — secret.
BRAVE_API_KEY=
# Required for provider=searxng
SEARXNG_URL=
CHRONO_SEARCH_RESULTS=5
# Cap results from any one site: five pages of one publisher is one source told
# five ways, and it crowds out the corroboration worth having.
CHRONO_SEARCH_MAX_PER_DOMAIN=2
# Retries per query, with jittered backoff.
CHRONO_SEARCH_ATTEMPTS=3


# ==============================================================================
# Narrava Studio
# ==============================================================================
# openai | deepseek
NARRAVA_LLM_PROVIDER=openai
# Used to estimate beat length, which places media on the timeline.
NARRAVA_WORDS_PER_MINUTE=150
# auto | placeholder (deterministic offline placeholders for dev/CI)
NARRAVA_MEDIA_PROVIDER=auto
NARRAVA_MEDIA_PER_SEGMENT=1
NARRAVA_MEDIA_TIMEOUT_S=15

# Stock media keys — search fans out across whichever are set. Wikimedia Commons
# needs no key, so search always returns something. Both secret.
PIXABAY_API_KEY=
PEXELS_API_KEY=


# ==============================================================================
# Dossier Nova
# ==============================================================================
# Model comes from DOSSIER_MODEL / DEEPSEEK_MODEL above, and it reuses
# DEEPSEEK_TIMEOUT_SECONDS and DEEPSEEK_MAX_RETRIES.

# Blank = <base>/tmp/pizza.txt and <base>/toc/full.md respectively.
INPUT_TEXT_PATH=
TOC_FULL_PATH=

CATCHALL_HEADING=Miscellaneous
TOC_TARGET_HEADING_COUNT=60
CONSERVATIVE_MODE=false

# Source-only mode: the dossier contains ONLY verbatim spans of the sources.
# Every organized passage is checked against its source and dropped if it cannot be
# found there, and the AI-authored front matter (executive summary, confidence
# verdicts, fact/allegation calls) is withheld from the dossier. The research dataset
# still receives it. Set to false for the older synthesized-prose dossier.
SOURCE_ONLY_MODE=true

# How many LLM calls are in flight at once, across every pipeline stage. These are pure
# network wait, so the ceiling is the provider's rate limit rather than this box's CPU.
LLM_MAX_WORKERS=16
# Skip the cleanup pass on sources with no extraction damage. Article text (Readability)
# has none of the OCR/merged-word artifacts cleanup exists to repair, so this removes a
# whole LLM stage from any URL-sourced dossier. Damaged PDFs are still cleaned.
SKIP_CLEAN_WHEN_UNDAMAGED=true

# Chunking + extraction
MAX_CHUNK_CHARS=20000
OVERLAP_PARAGRAPHS=2
CLEAN_EXTRACTED_TEXT=true
CLEANUP_CHUNK_SIZE=12000

# Similarity / dedup thresholds
SIMILARITY_THRESHOLD=0.75
CONTENT_SIMILARITY_THRESHOLD=0.95
SEMANTIC_SIMILARITY_DROP=0.2
CLAIM_DEDUP_THRESHOLD=0.90
MAX_DUPLICATION_RATIO=0.15
COVERAGE_THRESHOLD=0.85
EMBEDDING_DIMENSIONS=384

# Source correlation + profiling
ENABLE_SOURCE_PROFILING=true
PROFILE_SAMPLE_CHARS=4000
ENABLE_CORRELATION=true
SYNTHESIS_SAMPLE_CHARS=8000
MAX_SOURCE_SHARE=0.40


# ==============================================================================
# Outbound email (contact form)
# ==============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# secret
SMTP_PASS=
# Blank = SMTP_USER
DEFAULT_FROM=
EMAIL_TO=
